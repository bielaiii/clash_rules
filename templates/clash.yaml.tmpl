    interval: 300
    tolerance: 50
    lazy: false
  - name: 🇸🇬 新加坡地区
    type: url-test
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    filter: '(?i)新加坡|SG|Singapore'
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: false
  - name: 🇭🇰 香港地区
    type: url-test
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    filter: '(?i)香港|HK|Hong Kong'
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: false
  - name: 🇹🇼 台湾地区
    type: url-test
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    filter: '(?i)台湾|TW|Taiwan|台北'
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: false
  - name: 🧱 黑名单
    type: select
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    proxies: [REJECT, 🚀 节点选择, 📶 手动测速]

