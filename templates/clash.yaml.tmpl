    type: http
    behavior: classical
    url: '__RULES_BASE_URL__/Microsoft/Microsoft.list'
    format: text
    path: ./cache/rules/microsoft.list
    interval: 86400
  Apple:
    type: http
    behavior: classical
    url: '__RULES_BASE_URL__/Apple/Apple.list'
    format: text
    path: ./cache/rules/apple.list
    interval: 86400
  OpenAI:
    type: http
    behavior: classical
    url: '__RULES_BASE_URL__/OpenAI/OpenAI.list'
    format: text
    path: ./cache/rules/openai.list
    interval: 86400
  Telegram:
    type: http
    behavior: classical
    url: '__RULES_BASE_URL__/Telegram/Telegram.list'
