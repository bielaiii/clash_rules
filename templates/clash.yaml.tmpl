    format: text
    path: ./cache/rules/youtube.list
    interval: 86400
  Steam:
    type: http
    behavior: classical
    url: '__RULES_BASE_URL__/Steam/Steam.list'
    format: text
    path: ./cache/rules/steam.list
    interval: 86400
  Advertising:
    type: http
    behavior: classical
