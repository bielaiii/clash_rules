# Generated by scripts/render_config.py; edit config/*.env and local rules instead.
# Target: mihomo / Clash Meta

mixed-port: 7890
# WSL2/其他局域网客户端需要访问 Windows 上的 Clash 端口。
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
external-controller: 127.0.0.1:9090
__SECRET_LINE__
profile:
  store-selected: true
  store-fake-ip: true

# TUN makes WSL/CLI traffic work without HTTP_PROXY environment variables.
# Clash Verge may ask for administrator permission when enabling the TUN stack.
tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    HTTP:
      ports: [80, 8080]
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

dns:
  enable: true
  ipv6: false
  prefer-h3: false
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - localhost.ptlogin2.qq.com
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
  # 节点及直连请求独立解析，避免代理 DNS 的循环依赖。
  proxy-server-nameserver:
    - 'https://223.5.5.5/dns-query#DIRECT'
    - 'https://doh.pub/dns-query#DIRECT'
  direct-nameserver:
    - 'https://223.5.5.5/dns-query#DIRECT'
    - 'https://doh.pub/dns-query#DIRECT'
  # 显式清空订阅可能带入的旧 fallback。
  fallback: []
  nameserver:
    - 'https://1.1.1.1/dns-query#🚀 节点选择'
    - 'https://8.8.8.8/dns-query#🚀 节点选择'
proxy-providers:
__SUBSCRIPTION_PROVIDERS__

proxy-groups:
  - name: 🚀 节点选择
    type: select
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    proxies: [📶 手动测速, 🇺🇸 美国地区, 🇯🇵 日本地区, 🇸🇬 新加坡地区, 🇭🇰 香港地区, 🇹🇼 台湾地区, DIRECT]
  - name: 📶 手动测速
    type: select
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
  - name: 🌐 常见外国网页
    type: select
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
    proxies: [🚀 节点选择, 📶 手动测速, 🇺🇸 美国地区, 🇯🇵 日本地区, 🇸🇬 新加坡地区, 🇭🇰 香港地区, 🇹🇼 台湾地区, DIRECT]
  - name: 网站分流
    type: select
    use: [__SUBSCRIPTION_PROVIDER_NAMES__]
