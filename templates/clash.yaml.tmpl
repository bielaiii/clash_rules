# Generated by scripts/render_config.py; edit config/*.env and local rules instead.
# Target: mihomo / Clash Meta

mixed-port: 7890
# WSL2/其他局域网客户端需要访问 Windows 上的 Clash 端口。
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
external-controller: 127.0.0.1:9090
__SECRET_LINE__
profile:
  store-selected: true
  store-fake-ip: true

# TUN makes WSL/CLI traffic work without HTTP_PROXY environment variables.
# Clash Verge may ask for administrator permission when enabling the TUN stack.
tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

geodata-mode: true
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip-lite.dat
  geosite: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - localhost.ptlogin2.qq.com
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
      - 0.0.0.0/32

proxy-providers:
  subscription:
    type: http
    url: __SUBSCRIPTION_URL__
    interval: 86400
    path: ./cache/proxy-providers/subscription.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 300

proxy-groups:
  - name: 🚀 节点选择
    type: select
    proxies: [📶 手动测速, 🌐 常见外国网页, 🇺🇸 美国地区, 🇯🇵 日本地区, 🇸🇬 新加坡地区, 🇭🇰 香港地区, 🇹🇼 台湾地区, DIRECT]
  - name: 📶 手动测速
    type: select
    use: [subscription]
  - name: 🌐 常见外国网页
    type: select
    proxies: [📶 手动测速, 🇺🇸 美国地区, 🇯🇵 日本地区, 🇸🇬 新加坡地区, 🇭🇰 香港地区, 🇹🇼 台湾地区, DIRECT]
  - name: 🤖 OpenAI
    type: select
    proxies: [🚀 节点选择, 🇺🇸 美国地区, 🇯🇵 日本地区, 📶 手动测速]
  - name: Ⓜ️ Microsoft
    type: select
    proxies: [🚀 节点选择, 📶 手动测速, DIRECT]
  - name: 🍎 Apple
    type: select
    proxies: [DIRECT, 🚀 节点选择, 📶 手动测速]
  - name: 📲 Telegram
    type: select
    proxies: [🚀 节点选择, 📶 手动测速, 🇸🇬 新加坡地区, 🇭🇰 香港地区]
  - name: 📺 YouTube
    type: select
    proxies: [🚀 节点选择, 📶 手动测速, 🇺🇸 美国地区, 🇯🇵 日本地区]
  - name: 🎮 Steam
    type: select
    proxies: [🚀 节点选择, 📶 手动测速, DIRECT]
  - name: 🇨🇳 中国大陆
    type: select
    proxies: [DIRECT, 🚀 节点选择]
  - name: 🇺🇸 美国地区
    type: select
    use: [subscription]
    filter: '(?i)美国|US|United States|洛杉矶|纽约|西雅图|硅谷|华盛顿'
  - name: 🇯🇵 日本地区
    type: select
    use: [subscription]
    filter: '(?i)日本|JP|Japan|东京|大阪'
  - name: 🇸🇬 新加坡地区
    type: select
    use: [subscription]
    filter: '(?i)新加坡|SG|Singapore'
  - name: 🇭🇰 香港地区
    type: select
    use: [subscription]
    filter: '(?i)香港|HK|Hong Kong'
  - name: 🇹🇼 台湾地区
    type: select
    use: [subscription]
    filter: '(?i)台湾|TW|Taiwan|台北'
  - name: 🧱 黑名单
    type: select
    proxies: [REJECT, 🚀 节点选择]

