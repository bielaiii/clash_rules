rules:
__LOCAL_RULES__
  - RULE-SET,Advertising,REJECT
  - RULE-SET,LocalDirect,DIRECT
  - RULE-SET,LocalProxy,🚀 节点选择
  - RULE-SET,OpenAI,🇺🇸 美国地区
  - RULE-SET,Google,🌐 常见外国网页
  - RULE-SET,Microsoft,Ⓜ️ Microsoft
  - RULE-SET,Apple,🍎 Apple
  - RULE-SET,Telegram,📲 Telegram
  - RULE-SET,YouTube,📺 YouTube
  - RULE-SET,Steam,🎮 Steam
  - GEOSITE,CN,🇨🇳 中国大陆
  - GEOIP,CN,🇨🇳 中国大陆,no-resolve
  - RULE-SET,ChinaMax,🇨🇳 中国大陆,no-resolve
  - GEOSITE,geolocation-!cn,🌐 常见外国网页
  - GEOIP,US,🇺🇸 美国地区,no-resolve
  - GEOIP,JP,🇯🇵 日本地区,no-resolve
  - GEOIP,SG,🇸🇬 新加坡地区,no-resolve
  - GEOIP,HK,🇭🇰 香港地区,no-resolve
  - GEOIP,TW,🇹🇼 台湾地区,no-resolve
  - MATCH,🚀 节点选择
